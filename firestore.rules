rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Artworks collection: public read, no client write
    match /artworks/{artworkId} {
      allow read: if true;
      allow write: if false;
    }
    // Users collection: authenticated users can read/write their own profile
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    // Usernames collection: public read for availability check, auth write
    match /usernames/{username} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }
    // Reports collection: authenticated users can create, no read
    match /reports/{reportId} {
      allow create: if request.auth != null;
      allow read, update, delete: if false;
    }
  }
}
